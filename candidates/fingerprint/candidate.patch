+"""Recognition tests only: shared camera identity still requires the radar.
+
+CW tuning restrictions predate this IQ-specific exception. These tests establish
+identification boundaries, not controller suitability for every ECU combination.
+"""
+import unittest
+
+from iqdbc.car.fw_query_definitions import ESSENTIAL_ECUS
+from iqdbc.car.fw_versions import match_fw_to_car
+from iqdbc.car.hyundai.fingerprints import FW_VERSIONS
+from iqdbc.car.hyundai.values import CAR, FW_QUERY_CONFIG
+from iqdbc.car.structs import CarParams
+from iqdbc.car.vin import VIN_UNKNOWN
+
+
+CAMERA = b'\xf1\x00NX4 FR_CMR AT USA LHD 1.00 1.00 99211-CW020 14Z'
+Ecu = CarParams.Ecu
+CAMERA_KEY = (Ecu.fwdCamera, 0x7c4, None)
+RADAR_KEY = (Ecu.fwdRadar, 0x7d0, None)
+TUCSON = CAR.HYUNDAI_TUCSON_4TH_GEN
+SANTA_CRUZ = CAR.HYUNDAI_SANTA_CRUZ_1ST_GEN
+
+
+def camera(version=CAMERA, **kwargs):
+  return CarParams.CarFw(ecu=Ecu.fwdCamera, address=0x7c4, brand=kwargs.pop('brand', 'hyundai'), fwVersion=version, **kwargs)
+
+
+def radar(version, **kwargs):
+  return CarParams.CarFw(ecu=Ecu.fwdRadar, address=0x7d0, brand=kwargs.pop('brand', 'hyundai'), fwVersion=version, **kwargs)
+
+
+class TestTucsonCW020(unittest.TestCase):
+  def assert_match(self, records, expected):
+    exact, matches = match_fw_to_car(records, VIN_UNKNOWN, log=False)
+    self.assertTrue(exact)
+    self.assertEqual(matches, expected)
+
+  def test_required_ecus_and_distinct_radars(self):
+    for model in (TUCSON, SANTA_CRUZ):
+      self.assertEqual(FW_VERSIONS[model][CAMERA_KEY].count(CAMERA), 1)
+      for ecu in (Ecu.fwdCamera, Ecu.fwdRadar):
+        self.assertIn(ecu, ESSENTIAL_ECUS)
+        self.assertNotIn(model, FW_QUERY_CONFIG.non_essential_ecus.get(ecu, []))
+    self.assertTrue(set(FW_VERSIONS[TUCSON][RADAR_KEY]).isdisjoint(FW_VERSIONS[SANTA_CRUZ][RADAR_KEY]))
+
+  def test_known_radars_select_their_own_platform(self):
+    # The database is per ECU, so this explicitly exposes its cross-product.
+    # Only the 1.01/1.00 N9100 combination has owner vehicle evidence.
+    for model in (TUCSON, SANTA_CRUZ):
+      for version in FW_VERSIONS[model][RADAR_KEY]:
+        with self.subTest(model=model, radar=version):
+          pair = [camera(), radar(version)]
+          self.assert_match(pair, {model})
+          self.assert_match(pair[::-1], {model})
+          self.assert_match(pair + pair, {model})
+
+  def test_missing_unknown_logging_and_wrong_brand_reject(self):
+    for model in (TUCSON, SANTA_CRUZ):
+      for version in FW_VERSIONS[model][RADAR_KEY]:
+        cases = {
+          'empty': [], 'camera_only': [camera()], 'radar_only': [radar(version)],
+          'unknown_camera': [camera(b'unknown'), radar(version)],
+          'unknown_cw_camera': [camera(CAMERA.replace(b'CW020', b'CW999')), radar(version)],
+          'different_cw_revision': [camera(CAMERA.replace(b'14Z', b'14Y')), radar(version)],
+          'unknown_radar': [camera(), radar(b'unknown')],
+          'logging_camera': [camera(logging=True), radar(version)],
+          'logging_radar': [camera(), radar(version, logging=True)],
+          'wrong_brand_camera': [camera(brand='mock'), radar(version)],
+          'wrong_brand_radar': [camera(), radar(version, brand='mock')],
+        }
+        for name, records in cases.items():
+          with self.subTest(model=model, radar=version, case=name):
+            self.assert_match(records, set())
+
+  def test_conflicting_radars_preserve_ambiguity(self):
+    for tucson in FW_VERSIONS[TUCSON][RADAR_KEY]:
+      for santa_cruz in FW_VERSIONS[SANTA_CRUZ][RADAR_KEY]:
+        with self.subTest(tucson=tucson, santa_cruz=santa_cruz):
+          self.assert_match([camera(), radar(tucson), radar(santa_cruz)], {TUCSON, SANTA_CRUZ})
+
+  def test_other_cw_versions_do_not_enable_tucson(self):
+    for version in FW_VERSIONS[SANTA_CRUZ][CAMERA_KEY]:
+      if version == CAMERA:
+        continue
+      for tucson in FW_VERSIONS[TUCSON][RADAR_KEY]:
+        with self.subTest(camera=version, radar=tucson):
+          self.assert_match([camera(version), radar(tucson)], set())
+
+  def test_existing_tucson_camera_radar_matrix(self):
+    for version in FW_VERSIONS[TUCSON][CAMERA_KEY]:
+      for tucson in FW_VERSIONS[TUCSON][RADAR_KEY]:
+        with self.subTest(camera=version, radar=tucson):
+          self.assert_match([camera(version), radar(tucson)], {TUCSON})
+
+
+if __name__ == '__main__':
+  unittest.main()
